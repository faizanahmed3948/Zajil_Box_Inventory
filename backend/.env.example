# Copy this file to .env and adjust as needed (not required for local dev).

# Defaults to SQLite (boxtrack.db in this folder). Point this at Postgres/MySQL
# in production, e.g.: postgresql://user:password@host:5432/boxtrack
DATABASE_URL=sqlite:///./boxtrack.db

# Used to sign JWT auth tokens - change this to a long random string in production.
JWT_SECRET=dev-secret-change-me-in-production
